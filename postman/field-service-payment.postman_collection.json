{
  "info": {
    "_postman_id": "7b5c6a9e-7e64-4a9e-a1ef-7bb2d3bb3d02",
    "name": "Field Service Management - Payment",
    "description": "Test authentication, bKash create/execute, and payment retrieval endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "customerEmail",
      "value": "customer@example.com"
    },
    {
      "key": "customerPassword",
      "value": "Password@123"
    },
    {
      "key": "invoiceId",
      "value": "replace-with-invoice-id"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "paymentID",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Login succeeded', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "if (json.data && json.data.accessToken) { pm.collectionVariables.set('accessToken', json.data.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create bKash Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "create"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Payment checkout created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "if (json.data && json.data.paymentID) { pm.collectionVariables.set('paymentID', json.data.paymentID); }",
              "if (json.data && json.data.payment && json.data.payment.id) { pm.collectionVariables.set('paymentId', json.data.payment.id); }",
              "if (json.data && json.data.bkashURL) { console.log('Open this bKash checkout URL:', json.data.bkashURL); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Execute bKash Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentID\": \"{{paymentID}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/execute",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "execute"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment execute request completed', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400, 502]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get My Payments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/my-payments?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "my-payments"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "5. Get Single Payment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}"]
        }
      }
    }
  ]
}
