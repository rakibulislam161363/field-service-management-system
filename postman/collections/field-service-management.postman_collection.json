{
  "info": {
    "_postman_id": "f2d2d5e2-7f55-4f9d-a0d8-field-service-api",
    "name": "Field Service Management API",
    "description": "Import this collection into Postman. Set baseUrl and credentials in collection variables, then run requests in workflow order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const json = pm.response.json();",
          "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);",
          "if (json.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
          "const data = json.data?.data ?? json.data;",
          "if (data?.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
          "if (data?.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
          "if (data?.id) pm.collectionVariables.set('lastId', data.id);",
          "const names = { 'Create category': 'categoryId', 'Create skill': 'skillId', 'Create request': 'serviceRequestId', 'Create assignment': 'assignmentId', 'Create work order': 'workOrderId', 'Create report': 'reportId', 'Create profile': 'customerProfileId', 'Create invoice': 'invoiceId', 'Create feedback': 'feedbackId', 'Create notification': 'notificationId', 'Create attachment metadata': 'attachmentId' };",
          "if (data?.id && names[pm.info.requestName]) pm.collectionVariables.set(names[pm.info.requestName], data.id);",
          "if (data?.payment?.id) pm.collectionVariables.set('paymentId', data.payment.id);"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "managerEmail", "value": "manager@example.com" },
    { "key": "technicianEmail", "value": "technician@example.com" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "userId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "serviceRequestId", "value": "" },
    { "key": "technicianId", "value": "" },
    { "key": "skillId", "value": "" },
    { "key": "assignmentId", "value": "" },
    { "key": "workOrderId", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "customerProfileId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "feedbackId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "attachmentId", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "header": [], "auth": { "type": "noauth" }, "url": "{{baseUrl}}/" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Customer\",\n  \"email\": \"new.customer@example.com\",\n  \"password\": \"ChangeMe123!\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/register" }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);", "pm.test('Login successful', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"] } }]
        },
        { "name": "Current user", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me" } },
        { "name": "Refresh token (cookie)", "request": { "method": "POST", "header": [], "auth": { "type": "noauth" }, "url": "{{baseUrl}}/api/auth/refresh-token" } },
        { "name": "Verify email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"new.customer@example.com\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/verify-email" } },
        { "name": "Forgot password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/forgot-password" } },
        { "name": "Reset password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"newPassword\": \"NewPassword123!\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/reset-password" } },
        { "name": "Google login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" }, "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN_HERE\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/google" } }
      ]
    },
